# ALL ENV ---------------------------------------------------------

APP_ENV=local

# Docker Compose
COMPOSE_PROJECT_NAME=movie_rater
PROJECT_NAME=movie_rater

# Host user for shared volumes (run `id -u` / `id -g` to fill)
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# Timezone
TZ=Europe/Rome

# Webserver
WEBSERVER_EXTERNAL_PORT=80

# Database (pgsql 5432 / mysql 3306)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=movie_rater
DB_USERNAME=movie_rater
DB_PASSWORD=movie_rater

# LARAVEL

APP_NAME="Movie Rater"

APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ONLY DEV --------------------------------------------------------

ADMINER_PORT=8081
MAILPIT_UI_PORT=8025
VITE_PORT=5173


# ONLY STAGING OR PRODUCTION --------------------------------------

SHARED_FOLDER=/opt/movie_rater
DOCKER_IMAGE=registry.intesys.it/movie-rater
