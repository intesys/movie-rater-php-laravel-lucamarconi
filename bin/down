#!/bin/bash
SCRIPTPATH="$( cd "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
source "$SCRIPTPATH/.env"
[ -z "$ENV" ] && echo "Must provide ENV var in bin/.env" && exit 1
echo "Remember to add -v if you want to remove volumes too"
docker compose \
    -f "$SCRIPTPATH/../docker-compose.yml" \
    -f "$SCRIPTPATH/../docker-compose.$ENV.yml" \
    down "$@"
