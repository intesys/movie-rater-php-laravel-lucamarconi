#!/bin/bash
SCRIPTPATH="$( cd "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P )"
source "$SCRIPTPATH/.env"
[ -z "$ENV" ] && echo "Must provide ENV var in bin/.env (e.g. ENV=dev)" && exit 1
echo "Remember to add --build if you want to rebuild the containers"
docker compose \
    -f "$SCRIPTPATH/../docker-compose.yml" \
    -f "$SCRIPTPATH/../docker-compose.$ENV.yml" \
    up -d --remove-orphans "$@"
